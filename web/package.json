{
  "name": "sightline-web",
  "private": true,
  "version": "1.0.0",
  "description": "Sightline website, browser app and audit API (Next.js)",
  "scripts": {
    "prepare-app": "tsc -p ../tsconfig.renderer.json && node --experimental-strip-types scripts/prepare-app.mts",
    "dev": "npm run prepare-app && next dev -p 3000",
    "build": "npm run prepare-app && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}
