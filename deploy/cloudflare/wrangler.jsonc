{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sightline",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROUTER",
        "class_name": "AuditRouter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AuditRouter"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "BACKENDS": "[{\"name\":\"vercel-1\",\"url\":\"https://sightline-api-1.vercel.app\",\"weight\":1,\"maxInFlight\":3},{\"name\":\"vercel-2\",\"url\":\"https://sightline-api-2.vercel.app\",\"weight\":1,\"maxInFlight\":3},{\"name\":\"netlify\",\"url\":\"https://sightline-api.netlify.app\",\"weight\":1,\"maxInFlight\":3},{\"name\":\"render\",\"url\":\"https://sightline-sg4d.onrender.com\",\"weight\":1,\"maxInFlight\":3}]",
    "CANONICAL_HOST": "sightaud.com",
    "RATE_PER_HOUR": "20",
    "HEADER_TIMEOUT_MS": "8000",
    "HEALTH_TIMEOUT_MS": "3000",
    "HEALTH_TTL_MS": "30000",
    "FAILURE_COOLDOWN_MS": "30000"
  },
  "observability": {
    "enabled": true
  }
}
