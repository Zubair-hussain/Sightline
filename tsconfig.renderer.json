{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "renderer/src",
    "outDir": "renderer/dist",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["renderer/src/**/*.ts", "types/**/*.d.ts"]
}
